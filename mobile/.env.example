# Optional. Copy to `.env.local` and restart `npm start`.
# Leave it unset in development: the app finds your computer on its own
# (it uses the same address that Expo shows in the QR code, port 4000).
# Set it for a deployed API (always HTTPS) or when auto-detection does not work.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:4000
