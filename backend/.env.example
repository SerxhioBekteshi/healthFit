DATABASE_URL="postgresql://gym:gym@localhost:5433/gym_app?schema=public"
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:4000"
PORT=4000
# Comma-separated web origins allowed to call the API with cookies.
CORS_ORIGINS="http://localhost:5173"
# Optional: where uploaded gym photos are stored (default: ./uploads).
# UPLOADS_DIR="./uploads"
# Optional rate limits per client IP: wrong sign-in attempts per 15 minutes, sign-up requests per hour.
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_SIGNUP_MAX=5
# RATE_LIMIT_INVITE_MAX=30
# Number of reverse proxies in front of the API (so the real client IP is used); 0 when none.
# TRUST_PROXY=0
