{
  "name": "gym-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "lint": "eslint shared/src backend/src backend/prisma frontend/src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"{shared,backend,frontend}/src/**/*.{ts,tsx}\"",
    "type-check": "npm run type-check -w shared && npm run type-check -w backend && npm run type-check -w frontend",
    "test": "npm run test -w backend",
    "i18n:check": "npm run i18n:check -w frontend",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:studio": "npm run db:studio -w backend"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  }
}
